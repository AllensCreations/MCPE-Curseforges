{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmitOnError": true,
    "allowSyntheticDefaultImports": true
  },
  "include": [
    "MCPEDL/**/*.ts",
    "build/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
