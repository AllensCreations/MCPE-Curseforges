{
  "format_version": "1.8.0",
  "render_controllers": {
    "controller.render.allenscreations.zombie": {
      "geometry": "query.is_baby ? Geometry.baby : Geometry.default",
      "materials": [
        {
          "*": "Material.default"
        }
      ],
      "textures": [
        "query.is_baby ? Texture.baby : (query.is_tamed ? Texture.tamed : Texture.default)"
      ]
    },
    "controller.render.allenscreations.skeleton": {
      "geometry": "Geometry.default",
      "materials": [
        {
          "*": "Material.default"
        }
      ],
      "textures": [
        "(query.is_tamed ? Texture.tamed : Texture.default)"
      ]
    }
  }
}
