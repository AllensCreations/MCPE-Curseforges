            "player"
          ],
          "seats": [
            {
              "position": [
                0.0,
                2.7,
                0.0
              ]
            }
          ]
        },
        "minecraft:input_ground_controlled": {},
        "minecraft:behavior.player_ride_tamed": {}
      },
      "allenscreations:wild": {
        "minecraft:tameable": {
          "probability": 0.5,
          "tame_items": [
            "allenscreations:beast_biscuit"
          ],
          "tame_event": {
            "event": "allenscreations:on_tame",
            "target": "self"
          }
        },
        "minecraft:anger_level": {
          "angry_threshold": 80,
          "angry_boost": 20,
          "anger_decrement_interval": 1.0,
          "default_annoyingness": 35,
          "default_projectile_annoyingness": 10,
          "max_anger": 150,
          "on_increase_sounds": [
            {
              "condition": "query.anger_level(this) >= 40",
              "sound": "listening_angry"
            },
            {
              "condition": "query.anger_level(this) >= 0",
              "sound": "listening"
            }
          ],
          "nuisance_filter": {
            "all_of": [
              {
                "operator": "not",
                "test": "is_family",
                "subject": "other",
                "value": "warden"
              },
              {
                "operator": "not",
                "test": "is_family",
                "subject": "other",
                "value": "inanimate"
              }
            ]
          },
          "remove_targets_below_angry_threshold": true
        },
        "minecraft:behavior.dig": {
          "duration": 5.5,
          "idle_time": 60,
          "vibration_is_disturbance": true,
          "suspicion_is_disturbance": true,
          "on_start": {
            "event": "on_digging_event"
          },
          "priority": 1
        },
        "minecraft:behavior.investigate_suspicious_location": {
          "speed_multiplier": 0.7,
          "priority": 5
        },
        "minecraft:behavior.roar": {
          "duration": 4.2,
          "priority": 2
        },
        "minecraft:behavior.sniff": {
          "duration": 4.16,
          "sniffing_radius": 24,
          "suspicion_radius_horizontal": 6,
          "suspicion_radius_vertical": 20,
          "cooldown_range": {
            "min": 5,
            "max": 10
          },
          "priority": 6
        },
        "minecraft:mob_effect": {
          "cooldown_time": 6,
          "effect_range": 20,
          "effect_time": 13,
          "entity_filter": {
            "all_of": [
              {
                "subject": "other",
                "test": "is_family",
                "value": "player"
              },
              {
                "operator": "not",
                "test": "has_ability",
                "subject": "other",
                "value": "invulnerable"
              }
            ]
          },
          "mob_effect": "darkness"
        },
        "minecraft:suspect_tracking": {},
        "minecraft:vibration_listener": {}
      }
    },
    "events": {
      "minecraft:emerged": {
        "add": {
          "component_groups": [
            "pushable"
          ]
        },
        "remove": {
          "component_groups": [
            "emerging"
          ]
        }
      },
      "minecraft:spawn_emerging": {
        "add": {
          "component_groups": [
            "emerging",
            "allenscreations:wild"
          ]
        }
      },
      "minecraft:entity_spawned": {
        "add": {
          "component_groups": [
            "pushable",
            "allenscreations:wild"
          ]
        }
      },
      "on_digging_event": {
        "remove": {
          "component_groups": [
            "pushable"
          ]
        }
      },
      "allenscreations:on_tame": {
        "add": {
          "component_groups": [
            "allenscreations:companion"
          ]
        },
        "emit_particle": {
          "particle": "totem_particle"
        },
        "play_sound": {
          "sound": "random.levelup"
        },
        "remove": {
          "component_groups": [
            "allenscreations:wild"
          ]
        },
        "queue_command": {
          "command": [
            "particle minecraft:heart_particle ~ ~1.5 ~",
            "effect @s resistance 10 5 true"
          ]
        }
      },
      "allenscreations:stay_on": {
        "queue_command": {
          "command": [
            "title @p actionbar \u00a7eStay"
          ]
        }
      },
      "allenscreations:stay_off": {
        "queue_command": {
          "command": [
            "title @p actionbar \u00a7aFollow"
          ]
        }
      }
    }
