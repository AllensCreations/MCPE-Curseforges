                "all_of": [
                  {
                    "test": "is_family",
                    "subject": "other",
                    "operator": "!=",
                    "value": "monster_companion"
                  },
                  {
                    "test": "is_family",
                    "subject": "other",
                    "operator": "!=",
                    "value": "player"
                  }
                ]
              }
            }
          ]
        },
        "minecraft:damage_sensor": {
          "triggers": [
            {
              "on_damage": {
                "filters": {
                  "any_of": [
                    {
                      "test": "is_family",
                      "subject": "other",
                      "value": "player"
                    },
                    {
                      "test": "is_family",
                      "subject": "other",
                      "value": "monster_companion"
                    }
                  ]
                }
              },
              "deals_damage": false
            }
          ]
        },
        "minecraft:healable": {
          "items": [
            {
              "item": "allenscreations:beast_biscuit",
              "heal_amount": 10
            },
            {
              "item": "allenscreations:golden_beast_biscuit",
              "heal_amount": 40,
              "effects": [
                {
                  "name": "regeneration",
                  "chance": 1.0,
                  "duration": 30,
                  "amplifier": 2
                }
              ]
            }
          ]
        },
        "minecraft:nameable": {
          "always_show": true,
          "allow_name_tag_renaming": true
        },
        "minecraft:loot": {
          "table": "loot_tables/empty.json"
        },
