          "priority": 2,
          "within_radius": 16,
          "must_see": true,
          "reselect_targets": true,
          "entity_types": [
            {
              "filters": {
                "all_of": [
                  {
                    "test": "is_family",
                    "subject": "other",
                    "value": "monster"
                  },
                  {
                    "test": "is_family",
                    "subject": "other",
                    "operator": "!=",
                    "value": "monster_companion"
                  },
                  {
                    "test": "has_target",
                    "subject": "other"
                  },
                  {
                    "test": "owner_distance",
                    "subject": "self",
                    "operator": "<=",
                    "value": 16
                  }
                ]
              },
              "max_dist": 16
            }
          ]
        },
        "minecraft:sittable": {
          "sit_event": {
            "event": "allenscreations:stay_on",
            "target": "self"
          },
          "stand_event": {
            "event": "allenscreations:stay_off",
            "target": "self"
          }
        },
        "minecraft:behavior.stay_while_sitting": {
          "priority": 2
        },
        "minecraft:type_family": {
          "family": [
            "warden",
            "monster",
            "mob",
            "monster_companion"
          ]
        },
        "minecraft:persistent": {},
        "minecraft:attack": {
          "damage": 15
        },
        "minecraft:ambient_sound_interval": {
          "event_name": "ambient",
          "range": 4.0,
          "value": 2.0
        },
        "minecraft:heartbeat": {
          "interval": "2.0"
        },
        "minecraft:rideable": {
          "seat_count": 1,
          "crouching_skip_interact": true,
          "interact_text": "action.interact.mount",
          "controlling_seat": 0,
