        "minecraft:behavior.emerge": {
          "duration": 7.0,
          "on_done": {
            "event": "minecraft:emerged",
            "target": "self"
          }
        }
      },
      "pushable": {
        "minecraft:pushable": {
          "is_pushable": true,
          "is_pushable_by_piston": true
        }
      },
      "allenscreations:companion": {
        "minecraft:is_tamed": {},
        "minecraft:behavior.follow_owner": {
          "priority": 3,
          "speed_multiplier": 1.35,
          "start_distance": 9.0,
          "stop_distance": 4.5,
          "post_teleport_distance": 5,
          "can_teleport": true
        },
        "minecraft:behavior.owner_hurt_by_target": {
          "priority": 1,
          "entity_types": [
            {
              "filters": {
                "all_of": [
                  {
                    "test": "is_family",
                    "subject": "other",
                    "operator": "!=",
                    "value": "monster_companion"
                  },
                  {
                    "test": "is_family",
                    "subject": "other",
                    "operator": "!=",
                    "value": "player"
                  }
                ]
              }
            }
          ]
        },
        "minecraft:behavior.owner_hurt_target": {
          "priority": 2,
          "entity_types": [
            {
              "filters": {
                "all_of": [
                  {
                    "test": "is_family",
                    "subject": "other",
                    "operator": "!=",
                    "value": "monster_companion"
                  },
                  {
                    "test": "is_family",
                    "subject": "other",
                    "operator": "!=",
                    "value": "player"
                  }
                ]
              }
            }
          ]
        },
        "minecraft:behavior.hurt_by_target": {
