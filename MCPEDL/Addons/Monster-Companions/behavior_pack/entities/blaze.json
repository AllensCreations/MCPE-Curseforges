        "sequence": [
          {
            "add": {
              "component_groups": [
                "allenscreations:wild"
              ]
            }
          },
          {
            "add": {
              "component_groups": [
                "mode_switcher"
              ]
            }
          }
        ]
      },
      "minecraft:on_hurt_event": {
        "add": {
          "component_groups": [
            "mode_switcher"
          ]
        }
      },
      "switch_to_ranged": {
        "add": {
          "component_groups": [
            "ranged_mode"
          ]
        },
        "remove": {
          "component_groups": [
            "melee_mode"
          ]
        }
      },
