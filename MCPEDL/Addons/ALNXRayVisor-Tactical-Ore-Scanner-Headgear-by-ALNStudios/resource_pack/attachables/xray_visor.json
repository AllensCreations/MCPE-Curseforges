{
  "format_version": "1.20.60",
  "minecraft:attachable": {
    "description": {
      "identifier": "aln:xray_visor",
      "item": {
        "aln:xray_visor": "query.is_owner_identifier_any('minecraft:player')"
      },
      "materials": {
        "default": "armor",
        "enchanted": "armor_enchanted"
      },
      "textures": {
        "default": "textures/entity/attachable/xray_visor",
        "enchanted": "textures/misc/enchanted_item_glint"
      },
      "geometry": {
        "default": "geometry.aln.xray_visor"
      },
      "scripts": {
        "parent_setup": "variable.helmet_layer_visible = 0.0;"
      },
      "render_controllers": ["controller.render.armor"]
    }
  }
}
