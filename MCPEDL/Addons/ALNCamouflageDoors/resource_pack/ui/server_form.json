{
  "namespace": "server_form",
  "long_form": {
    "modifications": [
      {
        "array_name": "bindings",
        "operation": "insert_back",
        "value": [
          {
            "binding_name": "#title_text"
          },
          {
            "binding_type": "view",
            "source_property_name": "((#title_text - 'ALNPAINTER' - 'ALNPICKER') = #title_text)",
            "target_property_name": "#visible"
          }
        ]
      }
    ]
  },
