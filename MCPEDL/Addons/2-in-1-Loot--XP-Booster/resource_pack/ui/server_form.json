{
  "namespace": "server_form",
  "alnb_background": {
    "type": "image",
    "texture": "textures/ui/cheatstick/panel",
    "alpha": 0.96,
    "layer": 1
  },
  "long_form": {
    "type": "panel",
    "size": ["100%", "100%"],
    "controls": [
      {
        "default_long_form@common_dialogs.main_panel_no_buttons": {
          "$title_panel": "common_dialogs.standard_title_label",
          "$title_size": ["100% - 14px", 10],
          "size": [225, 200],
          "$text_name": "#title_text",
          "$title_text_binding_type": "none",
          "$child_control": "server_form.long_form_panel",
          "layer": 2,
          "bindings": [
            { "binding_name": "#title_text" },
            {
              "binding_type": "view",
              "source_property_name": "((#title_text - 'ALNStudios Booster') = #title_text)",
              "target_property_name": "#visible"
            }
          ]
        }
      },
      {
        "alnb_long_form@common_dialogs.main_panel_no_buttons": {
          "$title_panel": "common_dialogs.standard_title_label",
          "$title_size": ["100% - 14px", 10],
          "size": [190, 210],
          "$text_name": "#title_text",
          "$title_text_binding_type": "none",
          "$child_control": "server_form.long_form_panel",
          "$custom_background": "server_form.alnb_background",
          "$default_button_texture": "textures/ui/cheatstick/button",
          "$hover_button_texture": "textures/ui/cheatstick/button_hover",
          "$pressed_button_texture": "textures/ui/cheatstick/button_pressed",
          "layer": 2,
          "bindings": [
            { "binding_name": "#title_text" },
            {
              "binding_type": "view",
              "source_property_name": "(not ((#title_text - 'ALNStudios Booster') = #title_text))",
              "target_property_name": "#visible"
            }
          ]
        }
      }
    ]
  }
}
