  "wp_scrolling_content": {
    "type": "stack_panel",
    "size": [
      "100% - 4px",
      "100%c"
    ],
    "orientation": "vertical",
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "controls": [
      {
        "label_panel": {
          "type": "panel",
          "size": [
            "100%",
            "100%c"
          ],
          "controls": [
            {
              "main_label": {
                "type": "label",
                "color": [
                  0.722,
                  0.737,
                  0.776
                ],
                "size": [
                  "100%",
                  "default"
                ],
                "anchor_from": "top_left",
                "anchor_to": "top_left",
                "text": "#form_text",
                "bindings": [
                  {
                    "binding_name": "#form_text"
                  }
                ]
              }
            }
          ]
        }
      },
      {
        "padding": {
          "type": "panel",
          "size": [
            "100%",
            6
          ]
        }
      },
      {
        "wp_buttons@server_form.wp_buttons_panel": {}
      }
    ]
  },
  "wp_buttons_panel": {
    "type": "stack_panel",
    "size": [
      "100%",
      "100%c"
    ],
    "orientation": "vertical",
    "anchor_from": "top_middle",
    "anchor_to": "top_middle",
    "factory": {
      "name": "buttons",
      "control_ids": {
        "button": "server_form.wp_button"
      }
    },
    "collection_name": "form_buttons",
    "bindings": [
      {
        "binding_name": "#form_button_contents",
        "binding_name_override": "#collection_length"
      }
    ]
  },
  "wp_button": {
    "type": "panel",
    "size": [
      "100%",
      24
    ],
    "controls": [
      {
        "wp_form_button": {
          "type": "button",
          "size": [
            "100%",
            20
          ],
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "default_control": "default",
          "hover_control": "hover",
          "pressed_control": "pressed",
          "button_mappings": [
            {
              "from_button_id": "button.menu_select",
              "to_button_id": "button.form_button_click",
              "mapping_type": "pressed"
            },
            {
              "from_button_id": "button.menu_ok",
              "to_button_id": "button.form_button_click",
              "mapping_type": "focused"
            }
          ],
          "bindings": [
            {
              "binding_type": "collection_details",
              "binding_collection_name": "form_buttons"
            }
          ],
          "controls": [
            {
              "default": {
                "type": "image",
                "texture": "textures/ui/cheatstick/button",
                "nineslice_size": 1,
                "size": [
                  "100%",
                  "100%"
                ],
                "layer": 1
              }
            },
            {
              "hover": {
                "type": "image",
                "texture": "textures/ui/cheatstick/button_hover",
                "nineslice_size": 1,
                "size": [
                  "100%",
                  "100%"
                ],
                "layer": 1
              }
            },
            {
              "pressed": {
                "type": "image",
                "texture": "textures/ui/cheatstick/button_pressed",
                "nineslice_size": 1,
                "size": [
                  "100%",
                  "100%"
                ],
                "layer": 1
              }
            },
            {
              "button_label": {
                "type": "label",
                "color": [
                  1,
                  1,
                  1
                ],
                "shadow": true,
                "layer": 3,
                "anchor_from": "center",
                "anchor_to": "center",
                "size": [
                  "100% - 6px",
                  "default"
                ],
                "max_size": [
                  "100% - 6px",
                  18
                ],
                "text_alignment": "center",
                "text": "#form_button_text",
                "bindings": [
                  {
                    "binding_name": "#form_button_text",
                    "binding_type": "collection",
                    "binding_collection_name": "form_buttons"
                  }
                ]
              }
            }
          ]
        }
      }
    ]
  }
}