{
  "namespace": "server_form",
  "main_screen_content": {
    "type": "panel",
    "size": [
      0,
      0
    ],
    "controls": [
      {
        "server_form_factory": {
          "type": "factory",
          "control_ids": {
            "long_form": "@server_form.wp_long_form_router",
            "custom_form": "@server_form.wp_custom_form_router"
          }
        }
      }
    ]
  },
  "wp_long_form_router": {
    "type": "panel",
    "size": [
      0,
      0
    ],
    "controls": [
      {
        "wp_themed": {
          "type": "panel",
          "size": [
            190,
            210
          ],
          "layer": 2,
          "bindings": [
            {
              "binding_name": "#title_text"
            },
            {
              "binding_type": "view",
              "source_property_name": "(not ((#title_text - 'WPH|') = #title_text))",
              "target_property_name": "#visible"
            }
          ],
          "controls": [
            {
              "backdrop": {
                "type": "image",
                "texture": "textures/ui/cheatstick/backdrop",
                "size": [
                  4000,
                  4000
                ],
                "keep_ratio": false,
                "layer": 0
              }
            },
            {
              "panel": {
                "type": "image",
                "texture": "textures/ui/cheatstick/panel",
                "nineslice_size": 3,
                "size": [
                  "100%",
                  "100%"
                ],
                "layer": 1
              }
            },
            {
              "title_bar": {
                "type": "image",
                "texture": "textures/ui/cheatstick/title_bar",
                "size": [
                  "100% - 4px",
                  18
                ],
                "offset": [
                  2,
                  2
                ],
                "anchor_from": "top_left",
                "anchor_to": "top_left",
                "layer": 2,
                "controls": [
                  {
                    "title_label": {
                      "type": "label",
                      "color": [
                        1,
                        1,
                        1
                      ],
                      "shadow": true,
                      "anchor_from": "center",
                      "anchor_to": "center",
                      "size": [
                        "100% - 8px",
                        "default"
                      ],
                      "text_alignment": "center",
                      "layer": 3,
                      "bindings": [
                        {
                          "binding_name": "#title_text"
                        },
                        {
                          "binding_type": "view",
                          "source_property_name": "(#title_text - 'WPH|')",
                          "target_property_name": "#text"
                        }
                      ]
                    }
                  }
                ]
              }
            },
            {
              "content_area": {
                "type": "panel",
                "size": [
                  "100% - 16px",
                  "100% - 32px"
                ],
                "offset": [
                  8,
                  24
                ],
                "anchor_from": "top_left",
                "anchor_to": "top_left",
                "layer": 3,
                "controls": [
                  {
                    "scrolling_panel@common.scrolling_panel": {
                      "anchor_to": "top_left",
                      "anchor_from": "top_left",
                      "$show_background": false,
                      "size": [
                        "100%",
                        "100%"
                      ],
                      "$scrolling_content": "server_form.wp_scrolling_content",
                      "$scroll_size": [
                        5,
                        "100% - 4px"
                      ],
                      "$scrolling_pane_size": [
                        "100% - 4px",
                        "100% - 2px"
                      ],
                      "$scrolling_pane_offset": [
                        2,
                        0
                      ],
                      "$scroll_bar_right_padding_size": [
                        0,
                        0
                      ]
                    }
                  }
                ]
              }
            }
          ]
        }
      },
      {
        "wp_vanilla@server_form.long_form": {
          "bindings": [
            {
              "binding_name": "#title_text"
            },
            {
              "binding_type": "view",
              "source_property_name": "((#title_text - 'WPH|') = #title_text)",
              "target_property_name": "#visible"
            }
          ]
        }
      }
    ]
  },
