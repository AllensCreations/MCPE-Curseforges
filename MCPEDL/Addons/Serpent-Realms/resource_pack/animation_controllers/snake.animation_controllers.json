{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.aln_snake.move": {
      "initial_state": "standing",
      "states": {
        "standing": {
          "blend_transition": 0.2,
          "animations": [
            "idle"
          ],
          "transitions": [
            {
              "moving": "query.modified_move_speed > 0.1"
            }
          ]
        },
        "moving": {
          "blend_transition": 0.2,
          "animations": [
            "slither"
          ],
          "transitions": [
            {
              "standing": "query.modified_move_speed < 0.1"
            }
          ]
        }
      }
    },
    "controller.animation.aln_snake.belly": {
      "initial_state": "normal",
      "states": {
        "normal": {
          "transitions": [
            {
              "swollen": "query.variant == 1"
            }
          ]
        },
        "swollen": {
          "blend_transition": 2.0,
          "animations": [
            "python_belly"
          ],
          "transitions": [
            {
              "normal": "query.variant != 1"
            }
          ]
        }
      }
    }
  }
}
