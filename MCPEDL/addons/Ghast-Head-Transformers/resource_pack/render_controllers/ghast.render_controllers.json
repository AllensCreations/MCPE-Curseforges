{
  "format_version": "1.8.0",
  "render_controllers": {
    "controller.render.ghast": {
      "arrays": {
        "geometries": {
          "Array.geos": [
            "Geometry.default",
            "Geometry.head",
            "Geometry.head",
            "Geometry.head",
            "Geometry.head",
            "Geometry.head",
            "Geometry.head"
          ]
        },
        "textures": {
          "Array.idle": [
            "Texture.default",
            "Texture.skeleton",
            "Texture.wither_skeleton",
            "Texture.zombie",
            "Texture.steve",
            "Texture.creeper",
            "Texture.piglin"
          ],
          "Array.charging": [
            "Texture.shooting",
            "Texture.skeleton_charging",
            "Texture.wither_skeleton_charging",
            "Texture.zombie_charging",
            "Texture.steve_charging",
            "Texture.creeper_charging",
            "Texture.piglin_charging"
          ]
        }
      },
      "geometry": "Array.geos[query.variant]",
      "materials": [
        {
          "*": "Material.default"
        }
      ],
      "part_visibility": [
        {
          "*": true
        },
        {
          "tentacles_*": "query.variant == 0",
          "hat": "query.variant != 0",
          "piglin_snout": "query.variant == 6",
          "piglin_ear_left": "query.variant == 6",
          "piglin_ear_right": "query.variant == 6"
        }
      ],
      "textures": [
        "(query.is_charging || variable.ischarging) ? Array.charging[query.variant] : Array.idle[query.variant]"
      ]
    }
  }
}
