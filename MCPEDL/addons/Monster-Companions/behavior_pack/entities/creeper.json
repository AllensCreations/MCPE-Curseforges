              "AND": [
                {
                  "OR": [
                    {
                      "test": "is_family",
                      "subject": 1,
                      "operator": 0,
                      "value": "ocelot"
                    },
                    {
                      "test": "is_family",
                      "subject": 1,
                      "operator": 0,
                      "value": "cat"
                    }
                  ]
                }
              ]
            },
            "max_dist": 6,
            "sprint_speed_multiplier": 1.2
          }
        ],
        "priority": 3
      },
      "minecraft:behavior.float": {
        "priority": 0
      },
      "minecraft:behavior.hurt_by_target": {
        "priority": 2
      },
      "minecraft:behavior.look_at_player": {
        "look_time": {
          "min": 1,
          "max": 2
        },
        "priority": 6
      },
      "minecraft:behavior.melee_attack": {
