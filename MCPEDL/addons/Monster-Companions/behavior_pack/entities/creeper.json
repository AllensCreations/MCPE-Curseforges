        "on_outside_range": {
          "event": "minecraft:stop_exploding",
          "target": "self"
        },
        "outside_range": 6
      },
      "minecraft:type_family": {
        "family": [
          "creeper",
          "monster",
          "mob"
        ]
      }
    },
    "component_groups": {
