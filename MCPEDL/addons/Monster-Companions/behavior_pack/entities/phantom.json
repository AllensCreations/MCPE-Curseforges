{
  "format_version": "1.26.0",
  "minecraft:entity": {
    "description": {
      "identifier": "minecraft:phantom",
      "is_summonable": true,
      "is_spawnable": true,
      "spawn_category": "monster"
    },
    "components": {
      "minecraft:attack": {
        "damage": 6
      },
      "minecraft:behavior.avoid_mob_type": {
        "ignore_visibility": true,
        "max_dist": 16,
        "entity_types": [
          {
            "filters": {
              "any_of": [
                {
                  "test": "is_family",
                  "subject": "other",
                  "value": "ocelot"
                },
                {
                  "test": "is_family",
                  "subject": "other",
                  "value": "cat"
                }
              ]
            }
          }
        ]
      },
      "minecraft:behavior.circle_around_anchor": {
        "goal_radius": 1,
        "height_offset_range": {
          "min": -4,
          "max": 5
        },
        "height_above_target_range": {
          "min": 20,
          "max": 40
        },
        "priority": 3
      },
      "minecraft:behavior.nearest_attackable_target": {
        "reselect_targets": true,
        "scan_interval": 20,
        "target_search_height": 80,
        "within_radius": 64,
        "must_see_forget_duration": 0.5,
        "entity_types": [
          {
            "filters": {
              "AND": [
                {
                  "test": "is_family",
                  "subject": 1,
                  "operator": 0,
                  "value": "player"
                }
              ]
            },
            "max_dist": 64
          }
        ],
        "priority": 1
      },
      "minecraft:behavior.swoop_attack": {
        "priority": 2
      },
      "minecraft:breathable": {
        "breathes_air": true,
        "breathes_water": true,
        "suffocate_time": 0,
        "total_supply": 15
      },
      "minecraft:burns_in_daylight": {},
      "minecraft:collision_box": {
        "height": 0.5,
        "width": 0.9
      },
      "minecraft:conditional_bandwidth_optimization": {},
      "minecraft:despawn": {
        "despawn_from_distance": {}
      },
      "minecraft:experience_reward": {
        "on_death": "query.last_hit_by_player ? 5 : 0"
      },
      "minecraft:follow_range": {
        "max": 64,
        "value": 64
      },
      "minecraft:game_event_movement_tracking": {
        "emit_flap": true
      },
      "minecraft:health": {
        "max": 20,
        "value": 20
      },
      "minecraft:hurt_on_condition": {
        "damage_conditions": [
          {
            "cause": "lava",
            "damage_per_tick": 4,
            "filters": {
              "operator": "==",
              "test": "in_lava",
              "subject": "self",
              "value": true
            }
          }
        ]
      },
      "minecraft:is_hidden_when_invisible": {},
      "minecraft:loot": {
        "table": "loot_tables/entities/phantom.json"
      },
      "minecraft:movement": {
        "value": 1.8
      },
      "minecraft:movement.glide": {
        "speed_when_turning": 0.2,
        "start_speed": 0.1
      },
      "minecraft:nameable": {},
      "minecraft:physics": {
        "has_gravity": false
      },
      "minecraft:pushable": {
        "is_pushable": true,
        "is_pushable_by_piston": true
      },
      "minecraft:renders_when_invisible": {},
      "minecraft:type_family": {
        "family": [
          "phantom",
          "undead",
          "monster",
          "mob"
        ]
      }
    },
    "events": {
      "allenscreations:on_tame": {
        "add": {
          "component_groups": [
            "allenscreations:companion"
          ]
        },
        "emit_particle": {
          "particle": "totem_particle"
        },
        "play_sound": {
          "sound": "random.levelup"
        },
        "remove": {
          "component_groups": [
            "allenscreations:wild"
          ]
        }
      },
      "minecraft:entity_spawned": {
        "add": {
          "component_groups": [
            "allenscreations:wild"
          ]
        }
      },
      "allenscreations:stay_on": {
        "queue_command": {
          "command": [
            "title @p actionbar §eStay"
          ]
        }
      },
      "allenscreations:stay_off": {
        "queue_command": {
          "command": [
            "title @p actionbar §aFollow"
          ]
        }
      }
    },
    "component_groups": {
      "allenscreations:companion": {
        "minecraft:is_tamed": {},
        "minecraft:type_family": {
          "family": [
            "phantom",
            "monster_companion",
            "mob"
          ]
        },
        "minecraft:behavior.follow_owner": {
          "priority": 3,
          "speed_multiplier": 1.35,
          "start_distance": 9.0,
          "stop_distance": 4.5,
          "post_teleport_distance": 5,
          "can_teleport": true
        },
        "minecraft:behavior.owner_hurt_by_target": {
          "priority": 1,
          "entity_types": [
            {
              "filters": {
                "all_of": [
                  {
                    "test": "is_family",
                    "subject": "other",
                    "operator": "!=",
                    "value": "monster_companion"
                  },
                  {
                    "test": "is_family",
                    "subject": "other",
                    "operator": "!=",
                    "value": "player"
                  }
                ]
              }
            }
          ]
        },
        "minecraft:behavior.owner_hurt_target": {
          "priority": 2,
          "entity_types": [
            {
              "filters": {
                "all_of": [
                  {
                    "test": "is_family",
                    "subject": "other",
                    "operator": "!=",
                    "value": "monster_companion"
                  },
                  {
                    "test": "is_family",
                    "subject": "other",
                    "operator": "!=",
                    "value": "player"
                  }
                ]
              }
            }
          ]
        },
        "minecraft:damage_sensor": {
          "triggers": [
            {
              "on_damage": {
                "filters": {
                  "any_of": [
                    {
                      "test": "is_family",
                      "subject": "other",
                      "value": "player"
                    },
                    {
                      "test": "is_family",
                      "subject": "other",
                      "value": "monster_companion"
                    }
                  ]
                }
              },
              "deals_damage": false
            }
          ]
        },
        "minecraft:loot": {
          "table": "loot_tables/empty.json"
        },
        "minecraft:healable": {
          "items": [
            {
              "item": "allenscreations:beast_biscuit",
              "heal_amount": 10
            },
            {
              "item": "allenscreations:golden_beast_biscuit",
              "heal_amount": 40,
              "effects": [
                {
                  "name": "regeneration",
                  "chance": 1.0,
                  "duration": 5,
                  "amplifier": 2
                }
              ]
            }
          ]
        },
        "minecraft:behavior.hurt_by_target": {
          "priority": 99,
          "entity_types": [
            {
              "filters": {
                "all_of": [
                  {
                    "test": "is_family",
                    "subject": "other",
                    "operator": "!=",
                    "value": "monster_companion"
                  },
                  {
                    "test": "is_family",
                    "subject": "other",
                    "operator": "!=",
                    "value": "player"
                  }
                ]
              }
            }
          ]
        },
        "minecraft:nameable": {
          "always_show": true,
          "allow_name_tag_renaming": true
        },
        "minecraft:behavior.nearest_attackable_target": {
          "priority": 2,
          "within_radius": 16,
          "must_see": true,
          "reselect_targets": true,
          "entity_types": [
            {
              "filters": {
                "all_of": [
                  {
                    "test": "is_family",
                    "subject": "other",
                    "value": "monster"
                  },
                  {
                    "test": "is_family",
                    "subject": "other",
                    "operator": "!=",
                    "value": "monster_companion"
                  },
                  {
                    "test": "has_target",
                    "subject": "other"
                  },
                  {
                    "test": "owner_distance",
                    "subject": "self",
                    "operator": "<=",
                    "value": 16
                  }
                ]
              },
              "max_dist": 16
            }
          ]
        },
        "minecraft:sittable": {
          "sit_event": {
            "event": "allenscreations:stay_on",
            "target": "self"
          },
          "stand_event": {
            "event": "allenscreations:stay_off",
            "target": "self"
          }
        },
        "minecraft:behavior.stay_while_sitting": {
          "priority": 2
        }
      },
      "allenscreations:wild": {
        "minecraft:tameable": {
          "probability": 0.2,
          "tame_items": [
            "allenscreations:beast_biscuit"
          ],
          "tame_event": {
            "event": "allenscreations:on_tame",
            "target": "self"
          }
        }
      }
    }
  }
}
