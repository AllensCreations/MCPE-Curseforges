{
  "format_version": "1.20.30",
  "minecraft:attachable": {
    "description": {
      "identifier": "beaconhalo:regeneration_halo",
      "item": {
        "beaconhalo:regeneration_halo": "query.is_owner_identifier_any('minecraft:player')"
      },
      "materials": {
        "default": "entity_alphatest",
        "enchanted": "entity_alphatest_glint"
      },
      "textures": {
        "default": "textures/items/regeneration_halo",
        "enchanted": "textures/misc/enchanted_item_glint"
      },
      "geometry": {
        "default": "geometry.beaconhalo.halo"
      },
      "render_controllers": [
        "controller.render.item_default"
      ]
    }
  }
}
