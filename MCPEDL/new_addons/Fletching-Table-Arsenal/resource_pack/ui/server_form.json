{
  "namespace": "server_form",
  "long_form@common_dialogs.main_panel_no_buttons": {
    "$title_panel": "common_dialogs.standard_title_label",
    "$title_size": [
      "100% - 15px",
      10
    ],
    "$title_max_size": [
      "100% - 15px",
      10
    ],
    "size": [
      225,
      200
    ],
    "$text_name": "#title_text",
    "$title_text_binding_type": "none",
    "$child_control": "server_form.long_form_panel",
    "layer": 2,
    "bindings": [
      {
        "binding_name": "#title_text"
      },
      {
        "binding_type": "view",
        "source_property_name": "((#title_text - 'WORKBENCH') = #title_text)",
        "target_property_name": "#visible"
      }
    ]
  },
  "main_screen_content": {
    "modifications": [
      {
        "array_name": "controls",
        "operation": "insert_back",
        "value": [
          {
            "fwb_form@server_form.fwb_form": {}
          }
        ]
      }
    ]
  },
  "fwb_form@common_dialogs.main_panel_no_buttons": {
    "$title_panel": "common_dialogs.standard_title_label",
    "$title_size": [
      "100% - 15px",
      10
    ],
    "$title_max_size": [
      "100% - 15px",
      10
    ],
    "size": [
      240,
      214
    ],
    "$text_name": "#title_text",
    "$title_text_binding_type": "none",
    "$child_control": "server_form.fwb_panel",
    "layer": 2,
    "bindings": [
      {
        "binding_name": "#title_text"
      },
      {
        "binding_type": "view",
        "source_property_name": "(not ((#title_text - 'WORKBENCH') = #title_text))",
        "target_property_name": "#visible"
      }
    ]
  },
  "fwb_panel": {
    "type": "stack_panel",
    "size": [
      "100%",
      "100%"
    ],
    "orientation": "vertical",
    "layer": 1,
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "controls": [
      {
        "scrolling_panel@common.scrolling_panel": {
          "anchor_to": "top_left",
          "anchor_from": "top_left",
          "$show_background": false,
          "size": [
            "100%",
            "100%"
          ],
          "$scrolling_content": "server_form.fwb_scrolling_content",
          "$scroll_size": [
            5,
            "100% - 4px"
          ],
          "$scrolling_pane_size": [
            "100% - 4px",
            "100% - 2px"
          ],
          "$scrolling_pane_offset": [
            2,
            0
          ],
          "$scroll_bar_right_padding_size": [
            0,
            0
          ]
        }
      }
    ]
  },
  "fwb_scrolling_content": {
    "type": "stack_panel",
    "size": [
      "100% - 4px",
      "100%c"
    ],
    "orientation": "vertical",
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "controls": [
      {
        "fwb_inset": {
          "type": "panel",
          "size": [
            "100%",
            "100%c"
          ],
          "controls": [
            {
              "fwb_inset_bg": {
                "type": "image",
                "texture": "textures/ui/Black",
                "alpha": 0.45,
                "size": [
                  "100%",
                  "100%"
                ],
                "layer": 1
              }
            },
            {
              "fwb_inset_label": {
                "type": "label",
                "layer": 2,
                "offset": [
                  6,
                  5
                ],
                "color": "$main_header_text_color",
                "size": [
                  "100% - 12px",
                  "default"
                ],
                "anchor_from": "top_left",
                "anchor_to": "top_left",
                "text": "#form_text"
              }
            }
          ]
        }
      },
      {
        "fwb_gap": {
          "type": "panel",
          "size": [
            "100%",
            6
          ]
        }
      },
      {
        "fwb_buttons_wrap": {
          "type": "panel",
          "size": [
            "100%",
            "100%c"
          ],
          "controls": [
            {
              "fwb_buttons@server_form.fwb_buttons_panel": {}
            }
          ]
        }
      }
    ]
  },
  "fwb_buttons_panel": {
    "type": "stack_panel",
    "size": [
      "100% - 4px",
      "100%c"
    ],
    "offset": [
      2,
      0
    ],
    "orientation": "vertical",
    "anchor_from": "top_middle",
    "anchor_to": "top_middle",
    "factory": {
      "name": "buttons",
      "control_ids": {
        "button": "server_form.fwb_button",
        "label": "@server_form.dynamic_label",
        "header": "@server_form.dynamic_header",
        "divider": "@settings_common.option_group_section_divider"
      }
    },
    "collection_name": "form_buttons",
    "bindings": [
      {
        "binding_name": "#form_button_contents",
        "binding_name_override": "#collection_length"
      }
    ]
  },
  "fwb_button": {
    "type": "stack_panel",
    "size": [
      "100%",
      36
    ],
    "orientation": "horizontal",
    "controls": [
      {
        "slot_panel": {
          "type": "panel",
          "size": [
            38,
            "100%"
          ],
          "bindings": [
            {
              "binding_type": "view",
              "source_control_name": "slot_icon",
              "resolve_sibling_scope": true,
              "source_property_name": "(not (#texture = ''))",
              "target_property_name": "#visible"
            }
          ],
          "controls": [
            {
              "slot_frame": {
                "type": "image",
                "texture": "textures/ui/item_cell",
                "size": [
                  36,
                  36
                ],
                "layer": 1
              }
            },
            {
              "slot_icon": {
                "type": "image",
                "layer": 2,
                "size": [
                  28,
                  28
                ],
                "offset": [
                  0,
                  0
                ],
                "bindings": [
                  {
                    "binding_name": "#form_button_texture",
                    "binding_name_override": "#texture",
                    "binding_type": "collection",
                    "binding_collection_name": "form_buttons"
                  },
                  {
                    "binding_name": "#form_button_texture_file_system",
                    "binding_name_override": "#texture_file_system",
                    "binding_type": "collection",
                    "binding_collection_name": "form_buttons"
                  },
                  {
                    "binding_type": "view",
                    "source_property_name": "(not ((#texture = '') or (#texture = 'loading')))",
                    "target_property_name": "#visible"
                  }
                ]
              }
            }
          ]
        }
      },
      {
        "form_button@common_buttons.light_text_button": {
          "$pressed_button_name": "button.form_button_click",
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "size": [
            "fill",
            36
          ],
          "$button_text": "#form_button_text",
          "$button_text_binding_type": "collection",
          "$button_text_grid_collection_name": "form_buttons",
          "$button_text_max_size": [
            "100%",
            32
          ],
          "bindings": [
            {
              "binding_type": "collection_details",
              "binding_collection_name": "form_buttons"
            }
          ]
        }
      }
    ]
  }
}