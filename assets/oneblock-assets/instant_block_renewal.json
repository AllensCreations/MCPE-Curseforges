{
  "id": "instant_block_renewal",
  "name": "1-Tick Instant Auto-Renewal Mechanism",
  "category": "core_mechanics",
  "version": "1.0.0",
  "description": "Synchronous event-driven 1-tick block regeneration that replaces the broken OneBlock altar faster than player gravity fall acceleration, ensuring the player's collision box is instantly caught by the new solid block.",
  "config": {
    "renewal_delay_ticks": 1,
    "altar_coordinate": {
      "x": 0,
      "y": 64,
      "z": 0
    },
    "trigger_event": "afterEvents.playerBreakBlock",
    "backup_tick_watchdog": true,
    "detect_air_trigger": true,
    "prevent_gravity_blocks_falling": true,
    "sound_feedback": "random.pop"
  },
  "implementation": {
    "event_subscription": "world.afterEvents.playerBreakBlock.subscribe((event) => { if (event.block.location.x === 0 && event.block.location.y === 64 && event.block.location.z === 0) { system.run(() => renewOneBlock(event.dimension)); } });",
    "watchdog_interval_ticks": 1
  }
}
