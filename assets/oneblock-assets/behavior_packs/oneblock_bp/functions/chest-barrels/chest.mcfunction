# Jai Shree Ram # Om namah shivay!

# NEW CHEST SYSTEM - Structure load based, no repeat in same level
# rand_chest (1-6) = level ka random starting offset (set at level change)
# chest_adhmy = chest counter (0 se start, 1-6 tak count karta hai per level)
# Formula: variant = ((rand_chest-1 + chest_adhmy) % 6) + 1  [chest_adhmy 0-indexed after increment]

playsound random.levelup @a 0 51 0 10 1

# Particles
execute at @e[type=minecraft:armor_stand,tag=OneBlockAnchor] positioned 0 50.10 0 run particle minecraft:villager_happy ~0 ~1 ~0
execute at @e[type=minecraft:armor_stand,tag=OneBlockAnchor] positioned 0 50.10 0 run particle minecraft:villager_happy ~0.2 ~1.2 ~0.1
execute at @e[type=minecraft:armor_stand,tag=OneBlockAnchor] positioned 0 50.10 0 run particle minecraft:villager_happy ~-0.3 ~1.1 ~0.4
execute at @e[type=minecraft:armor_stand,tag=OneBlockAnchor] positioned 0 50.10 0 run particle minecraft:villager_happy ~0.4 ~0.9 ~-0.2
execute at @e[type=minecraft:armor_stand,tag=OneBlockAnchor] positioned 0 50.10 0 run particle minecraft:villager_happy ~-0.1 ~1.3 ~-0.3
execute at @e[type=minecraft:armor_stand,tag=OneBlockAnchor] positioned 0 50.10 0 run particle minecraft:villager_happy ~0.3 ~0.8 ~0.3
execute at @e[type=minecraft:armor_stand,tag=OneBlockAnchor] positioned 0 50.10 0 run particle minecraft:villager_happy ~-0.5 ~1.0 ~-0.4
execute at @e[type=minecraft:armor_stand,tag=OneBlockAnchor] positioned 0 50.10 0 run particle minecraft:villager_happy ~0.5 ~1.1 ~0.5
execute at @e[type=minecraft:armor_stand,tag=OneBlockAnchor] positioned 0 50.10 0 run particle minecraft:villager_happy ~0 ~1.2 ~-0.5
execute at @e[type=minecraft:armor_stand,tag=OneBlockAnchor] positioned 0 50.10 0 run particle minecraft:villager_happy ~-0.4 ~1.1 ~0

# Chest counter badhao (0->1->2->3->4->5->6, 6 tak pahunchte hi level ke saare chests complete)
scoreboard players add @e[type=minecraft:armor_stand,tag=OneBlockAnchor] chest_adhmy 1

